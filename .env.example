# Copy these variables into .env.local. Never use NEXT_PUBLIC_ for database secrets.
# DATABASE_URL: Neon connection string with connection pooling enabled.
DATABASE_URL=
# DIRECT_URL: Neon connection string with connection pooling disabled (for migrations).
DIRECT_URL=
# Random signing secret, at least 32 characters. Never prefix with NEXT_PUBLIC_.
BETTER_AUTH_SECRET=
# Development: http://localhost:3000; production: https://beautyroomky.com
BETTER_AUTH_URL=
