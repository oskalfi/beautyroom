generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  he
  en
  ru
}

model Client {
  id         String            @id @default(uuid()) @db.Uuid
  firstName  String            @db.VarChar(100)
  lastName   String?           @db.VarChar(100)
  phone      String            @db.VarChar(32)
  archivedAt DateTime?         @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  contacts   ClientContact[]
  records    TreatmentRecord[]

  // A family may share a phone number, so this is an index, not a unique key.
  @@index([phone])
  @@index([lastName, firstName])
}

model ClientContact {
  id        String   @id @default(uuid()) @db.Uuid
  clientId  String   @db.Uuid
  label     String   @db.VarChar(100)
  url       String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Treatment {
  // Numeric IDs preserve the existing /treatments/5 links when content is imported.
  id              Int                    @id @default(autoincrement())
  priceILS        Decimal?               @db.Decimal(12, 2)
  priceFrom       Boolean                @default(false)
  durationMinutes Int?
  durationFrom    Boolean                @default(false)
  isPublished     Boolean                @default(false)
  archivedAt      DateTime?              @db.Timestamptz(3)
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @db.Timestamptz(3)
  translations    TreatmentTranslation[]
  photos          Media[]
  records         TreatmentRecord[]
}

model TreatmentTranslation {
  id                    String    @id @default(uuid()) @db.Uuid
  treatmentId           Int
  locale                Locale
  name                  String    @db.VarChar(200)
  description           String    @db.Text
  concernsDescription   String    @default("") @db.Text
  concerns              Json      @default("[]")
  stepsDescription      String    @default("") @db.Text
  steps                 Json      @default("[]")
  skinTypes             String[]
  skinDescription       String    @default("") @db.Text
  contraindications     String[]
  contraindicationsNote String    @default("") @db.Text
  // Preserve the existing editorial provenance when importing website content.
  evidence              Json?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  treatment             Treatment @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@unique([treatmentId, locale])
}

model TreatmentRecord {
  id            String    @id @default(uuid()) @db.Uuid
  clientId      String    @db.Uuid
  treatmentId   Int
  performedAt   DateTime  @db.Timestamptz(3)
  // Snapshots keep history intact when the public name or price changes.
  treatmentName String    @db.VarChar(200)
  pricePaidILS  Decimal?  @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  treatment     Treatment @relation(fields: [treatmentId], references: [id], onDelete: Restrict)

  @@index([clientId, performedAt])
  @@index([treatmentId])
}

// Public website photos only. Private client photos need separate storage/access rules.
model Media {
  id          String     @id @default(uuid()) @db.Uuid
  treatmentId Int?
  url         String     @db.Text
  alt         String     @default("") @db.Text
  sortOrder   Int        @default(0)
  width       Int?
  height      Int?
  createdAt   DateTime   @default(now()) @db.Timestamptz(3)
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)

  @@index([treatmentId, sortOrder])
}
